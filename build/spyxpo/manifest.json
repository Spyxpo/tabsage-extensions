{
  "id": "spyxpo",
  "name": "Spyxpo",
  "version": "1.0.0",
  "description": "An official extension for Spyxpo.",
  "author": "Unknown",
  "homepage": null,
  "permissions": [
    "content_scripts",
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "tabsage-ui.js",
        "contributes.js",
        "vscode-shim.js",
        "extension.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_end"
    }
  ]
}
