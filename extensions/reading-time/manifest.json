{
  "id": "reading-time",
  "name": "Reading Time",
  "version": "1.0.1",
  "description": "Shows an estimated reading time badge on articles and other text-heavy pages.",
  "author": "Spyxpo",
  "homepage": "https://github.com/Spyxpo",
  "permissions": ["content_scripts"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ]
}
