{
  "id": "page-chatbot",
  "name": "Page Chatbot",
  "version": "1.1.0",
  "description": "Ask the on-device AI questions about the page you're on and read the answer in a dialog.",
  "author": "Spyxpo",
  "homepage": "https://github.com/Spyxpo",
  "permissions": [
    "content_scripts",
    "ai",
    "dialogs"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_end"
    }
  ]
}
